{
  "name": "dsh-music-dock",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A now-playing dock for the DSH sidebar: sync playlists from QQ Music and NetEase Cloud Music, show synced lyrics when idle and transport controls on hover.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
